diff --git a/backend/internal/service/account_empty_guard_switch_test.go b/backend/internal/service/account_empty_guard_switch_test.go
new file mode 100644
--- /dev/null
+++ b/backend/internal/service/account_empty_guard_switch_test.go
@@ -0,0 +1,78 @@
+package service
+
+import (
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/Wei-Shaw/sub2api/internal/config"
+	"github.com/gin-gonic/gin"
+)
+
+type placeholderSwitchReadProbe struct {
+	reader *strings.Reader
+	writer *httptest.ResponseRecorder
+	reads  int
+	t      *testing.T
+}
+
+func (p *placeholderSwitchReadProbe) Read(b []byte) (int, error) {
+	if p.reads == 0 {
+		p.reads++
+		return copy(b, switchTestPrelude), nil
+	}
+	if p.reads == 1 {
+		p.reads++
+		if !p.writer.Flushed || !strings.Contains(p.writer.Body.String(), "chatcmpl-gateway-placeholder") {
+			p.t.Error("disabled extension buffered AG placeholder")
+		}
+	}
+	return p.reader.Read(b)
+}
+
+const switchTestPrelude = "data: {\"id\":\"chatcmpl-gateway-placeholder\",\"object\":\"chat.completion.chunk\",\"choices\":[{\"index\":0,\"delta\":{\"role\":\"assistant\",\"content\":\"\"},\"finish_reason\":null}]}\n\n"
+
+func TestRawChatEmptyStreamGuardSwitch(t *testing.T) {
+	for _, tc := range []struct {
+		name                 string
+		env                  string
+		enabled, guard, want bool
+	}{
+		{"both-on", "1", true, true, true},
+		{"placeholder-off", "1", false, true, false},
+		{"guard-off", "1", true, false, false},
+		{"both-off", "1", false, false, false},
+		{"process-off", "0", true, true, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Setenv("ACCOUNT_STREAM_PLACEHOLDER", tc.env)
+			a := &Account{Extra: map[string]any{"stream_placeholder": map[string]any{"enabled": tc.enabled, "empty_stream_guard_enabled": tc.guard}}}
+			if got := accountChatEmptyStreamGuardEnabled(a); got != tc.want {
+				t.Fatalf("guard enabled=%v want=%v", got, tc.want)
+			}
+			if tc.want {
+				return
+			}
+			rec := httptest.NewRecorder()
+			c, _ := gin.CreateTestContext(rec)
+			c.Request = httptest.NewRequest("POST", "/v1/chat/completions", nil)
+			tail := chatFrame(`{"choices":[{"delta":{"content":"OK"},"finish_reason":"stop"}]}`) + "data: [DONE]\n\n"
+			probe := &placeholderSwitchReadProbe{reader: strings.NewReader(tail), writer: rec, t: t}
+			resp := &http.Response{StatusCode: 200, Header: http.Header{"Content-Type": []string{"text/event-stream"}}, Body: io.NopCloser(probe)}
+			svc := &OpenAIGatewayService{cfg: &config.Config{}}
+			_, err := svc.streamRawChatCompletions(c, resp, a, "m", "m", "m", nil, nil, time.Now(), 32)
+			if err != nil || rec.Body.String() != switchTestPrelude+tail {
+				t.Fatalf("passthrough changed: %v", err)
+			}
+		})
+	}
+	t.Setenv("ACCOUNT_STREAM_PLACEHOLDER", "1")
+	for _, a := range []*Account{nil, {}, {Extra: map[string]any{"stream_placeholder": map[string]any{"enabled": true}}}, {Extra: map[string]any{"stream_placeholder": map[string]any{"enabled": true, "empty_stream_guard_enabled": "true"}}}} {
+		if accountChatEmptyStreamGuardEnabled(a) {
+			t.Fatal("missing or invalid switch enabled guard")
+		}
+	}
+}
